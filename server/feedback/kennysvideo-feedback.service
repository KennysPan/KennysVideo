[Unit]
Description=KennysVideo feedback HTTP API
After=network-online.target
Wants=network-online.target

[Service]
User=kennysvideo-feedback
Group=kennysvideo-feedback
WorkingDirectory=/opt/kennysvideo-feedback
EnvironmentFile=/etc/kennysvideo-feedback.env
ExecStart=/usr/bin/gunicorn --workers 2 --bind 127.0.0.1:18790 --timeout 20 --limit-request-line 1024 --limit-request-field_size 4096 feedback:application
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=kennysvideo-feedback
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kennysvideo-feedback

[Install]
WantedBy=multi-user.target
