# Server-only file. Keep /etc/kennysvideo-feedback.env owned by root, mode 0600.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=sender@example.com
SMTP_PASSWORD=REPLACE_WITH_MAILBOX_SMTP_AUTHORIZATION_CODE
FEEDBACK_TO=maintainer@example.com
IP_HASH_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
FEEDBACK_DB=/var/lib/kennysvideo-feedback/feedback.sqlite3
ALLOWED_ORIGINS=http://tauri.localhost,https://tauri.localhost,https://www.kennyspan.xyz
IP_LIMIT=5
DAILY_LIMIT=100
