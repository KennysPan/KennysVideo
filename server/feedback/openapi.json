{
  "openapi": "3.0.3",
  "info": {"title": "KennysVideo feedback", "version": "1.1.0", "description": "Management routes and security requirements are additionally described in admin-contract.md."},
  "servers": [{"url": "https://www.kennyspan.xyz"}],
  "paths": {
    "/api/kennysvideo/feedback": {"post": {
      "summary": "Persist a fixed-recipient feedback report for SMTP delivery",
      "description": "Public endpoint. 5 reports/IP/15min and 100 reports/day by default. request_id deduplicates retries for 30 days. Acceptance means durable storage, not mailbox delivery. Fixed recipient is configured only on the server.",
      "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Report"}}}},
      "responses": {
        "202": {"description": "Persisted with success:true, report_id, status:queued"},
        "200": {"description": "Existing matching report with success:true and current delivery status"},
        "400": {"description": "Invalid fields or JSON"}, "403": {"description": "Browser origin denied"},
        "409": {"description": "Existing request_id has different content"}, "413": {"description": "Body exceeds 32768 bytes"},
        "415": {"description": "Requires application/json"}, "423": {"description": "Device temporarily restricted: success:false, code:device_blocked, blocked_until (Unix seconds); not queued"}, "429": {"description": "Submission rate limit; Retry-After 900 seconds"},
        "503": {"description": "Storage unavailable or queue full; no acceptance guarantee"}
      }
    }},
    "/api/kennysvideo/feedback/health": {"get": {"summary": "API availability only; does not prove SMTP delivery", "responses": {"200": {"description": "API running, service name and API version; no credentials"}}}},
    "/feedback-admin/login": {"post": {"summary": "Create an 8-hour administrator session", "description": "Same-origin only. Requires exact ADMIN_ORIGIN Origin header. Secure HttpOnly SameSite=Strict cookie; 5 failed logins per source IP per 15 minutes. No CORS.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["password"], "properties": {"password": {"type": "string", "maxLength": 256, "writeOnly": true}}}}}}, "responses": {"200": {"description": "success:true, csrf_token; Set-Cookie kv_admin"}, "401": {"description": "invalid_credentials"}, "403": {"description": "origin_denied"}, "429": {"description": "login_rate_limited; Retry-After:900"}, "503": {"description": "admin_not_configured or storage_unavailable"}}}},
    "/feedback-admin/session": {"get": {"summary": "Read current session CSRF token", "security": [{"adminCookie": []}], "responses": {"200": {"description": "success:true, csrf_token"}, "401": {"description": "login_required"}}}},
    "/feedback-admin/password": {"post": {"summary": "Change administrator password and revoke all sessions", "security": [{"adminCookie": [], "csrfHeader": []}], "description": "Requires exact ADMIN_ORIGIN Origin. Verifies current password and saves PBKDF2-SHA256 hash in SQLite, overriding bootstrap environment password. Five failed current-password checks per source IP per 15 minutes. All sessions are revoked on success; client must log in again. No password or hash is placed in audit details.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["current_password", "new_password"], "properties": {"current_password": {"type": "string", "maxLength": 256, "writeOnly": true}, "new_password": {"type": "string", "minLength": 6, "maxLength": 256, "writeOnly": true}}}}}}, "responses": {"200": {"description": "success:true, login_required:true; cookie expired; all sessions revoked"}, "400": {"description": "current_password_incorrect or invalid_new_password"}, "401": {"description": "login_required"}, "403": {"description": "Origin/CSRF denied"}, "429": {"description": "password_rate_limited; Retry-After:900"}}}},
    "/feedback-admin/logout": {"post": {"summary": "Revoke current session", "security": [{"adminCookie": [], "csrfHeader": []}], "description": "Requires exact ADMIN_ORIGIN Origin and an empty JSON object.", "requestBody": {"$ref": "#/components/requestBodies/AdminObject"}, "responses": {"200": {"description": "Session revoked; cookie expired"}, "401": {"description": "login_required"}, "403": {"description": "origin_denied or csrf_failed"}}}},
    "/feedback-admin/reports": {"get": {"summary": "List retained reports, private source IP and device summary", "security": [{"adminCookie": []}], "parameters": [{"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 1}}], "responses": {"200": {"description": "success:true, reports (up to 20), page, total. Each report includes id, title, description, steps, reply_email, version, platform, created (Unix seconds), state, source_ip (nullable), device (nullable hash prefix), category. Raw device UUID is never returned."}, "400": {"description": "invalid_page"}, "401": {"description": "login_required"}}}},
    "/feedback-admin/review": {"post": {"summary": "Classify a report manually", "security": [{"adminCookie": [], "csrfHeader": []}], "description": "Requires exact ADMIN_ORIGIN Origin. Records an audit event; no automatic sentiment moderation.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["report_id", "category"], "properties": {"report_id": {"type": "string", "format": "uuid"}, "category": {"type": "string", "enum": ["unreviewed", "actionable", "spam", "abuse", "duplicate", "other"]}}}}}}, "responses": {"200": {"description": "success:true"}, "400": {"description": "Invalid category or id"}, "401": {"description": "login_required"}, "403": {"description": "Origin/CSRF denied"}, "404": {"description": "report_not_found"}}}},
    "/feedback-admin/ban": {"post": {"summary": "Restrict future feedback from a report's installation hash", "security": [{"adminCookie": [], "csrfHeader": []}], "description": "Requires exact ADMIN_ORIGIN Origin. Replaces an existing restriction duration for this installation. Does not block other devices on the same IP, stop video playback, or cancel already queued mail.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["report_id", "days", "reason"], "properties": {"report_id": {"type": "string", "format": "uuid"}, "days": {"type": "integer", "minimum": 1, "maximum": 365}, "reason": {"type": "string", "minLength": 1, "maxLength": 300}}}}}}, "responses": {"200": {"description": "success:true; audit event recorded"}, "400": {"description": "invalid_ban"}, "401": {"description": "login_required"}, "403": {"description": "Origin/CSRF denied"}, "404": {"description": "report_not_found"}, "409": {"description": "legacy_device_unavailable"}}}},
    "/feedback-admin/bans": {"get": {"summary": "List up to 500 active restrictions", "security": [{"adminCookie": []}], "responses": {"200": {"description": "success:true, bans:[{id,device (hash prefix),until (Unix seconds),reason}]"}, "401": {"description": "login_required"}}}},
    "/feedback-admin/unban": {"post": {"summary": "Revoke a restriction by id", "security": [{"adminCookie": [], "csrfHeader": []}], "description": "Requires exact ADMIN_ORIGIN Origin. JSON ban_id; audit event recorded.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["ban_id"], "properties": {"ban_id": {"type": "string"}}}}}}, "responses": {"200": {"description": "success:true"}, "400": {"description": "ban_id_required"}, "401": {"description": "login_required"}, "403": {"description": "Origin/CSRF denied"}, "404": {"description": "ban_not_found"}}}},
    "/feedback-admin/audit": {"get": {"summary": "List latest 100 moderation events, retained up to 90 days", "security": [{"adminCookie": []}], "responses": {"200": {"description": "success:true, audit:[{created,action,target,detail}]"}, "401": {"description": "login_required"}}}}
  },
  "components": {"securitySchemes": {"adminCookie": {"type": "apiKey", "in": "cookie", "name": "kv_admin"}, "csrfHeader": {"type": "apiKey", "in": "header", "name": "X-CSRF-Token"}}, "requestBodies": {"AdminObject": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}}, "schemas": {"Report": {
    "type": "object", "additionalProperties": false,
    "required": ["request_id", "title", "description", "version", "platform"],
    "properties": {
      "request_id": {"type": "string", "format": "uuid"},
      "title": {"type": "string", "minLength": 1, "maxLength": 100},
      "description": {"type": "string", "minLength": 1, "maxLength": 4000},
      "steps": {"type": "string", "maxLength": 2000},
      "reply_email": {"type": "string", "maxLength": 254},
      "version": {"type": "string", "minLength": 1, "maxLength": 40},
      "platform": {"type": "string", "minLength": 1, "maxLength": 80},
      "device_id": {"type": "string", "format": "uuid", "description": "Random installation UUID, not a hardware identifier. Requires privacy_version:2. Stored only as a keyed hash."},
      "privacy_version": {"type": "integer", "enum": [2], "description": "Requires device_id. Client discloses source IP storage and temporary feedback restrictions. Legacy requests omit both."}
    }
  }}}
}
