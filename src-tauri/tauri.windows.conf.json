{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "useLocalToolsDir": true,
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "template": "installer-template.nsi",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KennysVideo",
        "width": 1000,
        "height": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "maximized": false,
        "minimizable": true,
        "maximizable": true,
        "closable": true
      }
    ]
  }
}
